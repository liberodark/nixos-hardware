diff --git a/drivers/cpufreq/spacemit-k3-cpufreq.c b/drivers/cpufreq/spacemit-k3-cpufreq.c
new file mode 100644
index 000000000..fc0121b3a
--- /dev/null
+++ b/drivers/cpufreq/spacemit-k3-cpufreq.c
@@ -0,0 +1,812 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <linux/cpufreq.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/init.h>
+#include <linux/cpu.h>
+#include <linux/cpumask.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/notifier.h>
+#include <linux/regulator/consumer.h>
+#include <linux/mutex.h>
+#include <linux/pm_opp.h>
+#include <linux/device.h>
+#include <linux/of.h>
+#include <linux/mfd/syscon.h>
+#include <linux/regmap.h>
+#include <linux/slab.h>
+#include <linux/smp.h>
+#include <soc/spacemit/k3-syscon.h>
+#include "../opp/opp.h"
+#include "cpufreq-dt.h"
+
+#define TURBO0_FREQUENCY		(1000000000)
+#define STABLE_FREQUENCY		(819200000)
+
+/* Fixed PLL1 sources of the cluster muxes a cluster can be parked on */
+static const unsigned long spacemit_park_rates[] = {
+	STABLE_FREQUENCY, 614400000, 491520000,
+};
+
+/*
+ * Cluster 1 behind the clock framework's back: source 7 of the cluster 1
+ * mux is PLL4 or PLL3 depending on C1_SRC7_PLL_SEL (APMU_CPU_C1_CLK_CTRL
+ * bit 13), which the mainline clock driver does not model; it always
+ * shows PLL4. Firmware 1.0.5 (FSBL "Cluster0/2 should be same as
+ * Cluster1/3") sets it: both clusters then run from PLL3, and the clock
+ * framework gates PLL3 as soon as cls0 leaves it, with cluster 1 still
+ * on it -- that cluster loses its clock and the machine freezes. The OPP
+ * core happens to be safe (scaling down moves cls1 first, scaling up
+ * moves cls0 first), so only this driver has to care: cls1 is always
+ * parked before cls0, and PLL3's divide-by-one output (pll_src) is held
+ * from the retune to POSTCHANGE, so cluster 1 finds it running whichever
+ * cluster the OPP core moves first. Harmless when cluster 1 is on PLL4.
+ */
+#define K3_C1_SRC7_PLL3		BIT(13)
+
+/* PLL handles cached at first transition (see spacemit_processor_notifier) */
+static DEFINE_MUTEX(spacemit_pll_lock);
+static bool spacemit_plls_cached;
+static struct clk *spacemit_pll_clst0, *spacemit_pll_clst1, *spacemit_pll_src;
+
+/*
+ * Margins around a PLL retune: time for a PLL that was just switched off
+ * to really stop before it is reprogrammed, and settling time beyond its
+ * lock flag before the OPP layer moves a cluster onto it. They were added
+ * while chasing the firmware 1.0.5 freeze, which turned out to be
+ * K3_C1_SRC7_PLL3; they cost well under a millisecond per turbo
+ * transition and are kept. The references taken on the PLLs are dropped
+ * at POSTCHANGE.
+ */
+#define PLL_OFF_SETTLE_US	100
+#define PLL_LOCK_SETTLE_US	300
+
+/*
+ * Policies (first related CPU) holding a reference on pll_src (PLL3 through
+ * its divide-by-one output, which also keeps PLL3 on) / pll_clst1 (PLL4).
+ * Per policy, like the other masks below: cpufreq serializes PRECHANGE ->
+ * POSTCHANGE per policy only, two policies may be in flight at once.
+ * Protected by spacemit_pll_lock.
+ */
+static struct cpumask spacemit_pll_holding[2];
+
+static void spacemit_pll_hold(int cpu, struct device *cpu_dev,
+			      struct clk *clk, int idx)
+{
+	if (cpumask_test_cpu(cpu, &spacemit_pll_holding[idx]))
+		return;
+	if (clk_prepare_enable(clk))
+		dev_warn_ratelimited(cpu_dev, "%s did not lock\n",
+				     idx ? "pll_clst1" : "pll_src");
+	else
+		cpumask_set_cpu(cpu, &spacemit_pll_holding[idx]);
+}
+
+static void spacemit_pll_release(int cpu)
+{
+	if (cpumask_test_and_clear_cpu(cpu, &spacemit_pll_holding[0]))
+		clk_disable_unprepare(spacemit_pll_src);
+	if (cpumask_test_and_clear_cpu(cpu, &spacemit_pll_holding[1]))
+		clk_disable_unprepare(spacemit_pll_clst1);
+}
+
+/*
+ * Idle harts sit in WFI. Moving a cluster clock off its PLL, reprogramming
+ * that PLL and switching back while harts of the cluster are in WFI has been
+ * seen to leave those harts stuck on K3: they stop ticking and ignore IPIs,
+ * and every interrupt routed to them (I2C, NVMe queues) times out. Vendor
+ * Linux never has a hart in WFI at that point (idle harts are powered down
+ * through SBI HSM) and firmware retunes the PLLs with a single hart running.
+ * So for the whole transition, PRECHANGE to POSTCHANGE, keep every hart
+ * polling instead of WFI. idle_guard=0 turns this off, for bring-up.
+ *
+ * One bit per policy (its first related CPU): a failed transition is
+ * reported as PRECHANGE + POSTCHANGE again, and policies may overlap.
+ * cpu_idle_poll_ctrl() itself is a counter.
+ */
+static bool idle_guard = true;
+module_param(idle_guard, bool, 0444);
+MODULE_PARM_DESC(idle_guard, "keep idle harts out of WFI during frequency transitions (default: on)");
+
+static struct cpumask spacemit_idle_guarded;	/* protected by spacemit_pll_lock */
+/* Policies whose cluster clocks this driver parked, same key and lock */
+static struct cpumask spacemit_parked;
+
+static void spacemit_idle_guard_kick(void *unused)
+{
+	/* Nothing to do: being here means this hart is out of WFI */
+}
+
+/*
+ * Polling is forced first, then every other hart is made to run the
+ * (empty) function and we wait for it: on return no hart is in WFI any
+ * more, and none re-enters it until the guard is dropped.
+ */
+static void spacemit_harts_awake(void)
+{
+	cpu_idle_poll_ctrl(true);
+	smp_call_function(spacemit_idle_guard_kick, NULL, 1);
+}
+
+static void spacemit_harts_release(void)
+{
+	cpu_idle_poll_ctrl(false);
+}
+
+static void spacemit_idle_guard_begin(struct cpufreq_policy *policy)
+{
+	if (!idle_guard)
+		return;
+
+	if (cpumask_test_and_set_cpu(cpumask_first(policy->related_cpus),
+				     &spacemit_idle_guarded))
+		return;
+
+	spacemit_harts_awake();
+}
+
+static void spacemit_idle_guard_end(struct cpufreq_policy *policy)
+{
+	if (!cpumask_test_and_clear_cpu(cpumask_first(policy->related_cpus),
+					&spacemit_idle_guarded))
+		return;
+
+	spacemit_harts_release();
+}
+
+/*
+ * True when @clk currently runs from @pll, directly or through one divider
+ * (pll3_d1/pll3_d2 for cluster 0, pll4_d1/pll4_d2 for cluster 1). An unknown
+ * topology counts as fed, so the caller parks the clock to be safe.
+ */
+static bool spacemit_clk_fed_by(struct clk *clk, struct clk *pll)
+{
+	struct clk *parent = clk_get_parent(clk);
+	int depth;
+
+	if (IS_ERR_OR_NULL(parent))
+		return true;
+
+	for (depth = 0; depth < 2 && !IS_ERR_OR_NULL(parent); depth++) {
+		if (!IS_ERR_OR_NULL(pll) && clk_is_match(parent, pll))
+			return true;
+		parent = clk_get_parent(parent);
+	}
+
+	return false;
+}
+
+/*
+ * True when the cluster rail is known to cover @rate: no regulator in the
+ * table (every enabled OPP is then at or below the firmware boot rate), or
+ * the regulator reads back at least the OPP voltage. A failed read means no.
+ */
+static bool spacemit_rail_covers(struct opp_table *opp_table,
+				 struct device *cpu_dev, unsigned long rate)
+{
+	struct dev_pm_opp *opp;
+	unsigned long uV;
+	int cur;
+
+	if (!opp_table->regulators)
+		return true;
+
+	opp = dev_pm_opp_find_freq_exact(cpu_dev, rate, true);
+	if (IS_ERR(opp))
+		return false;
+	uV = dev_pm_opp_get_voltage(opp);
+	dev_pm_opp_put(opp);
+
+	cur = regulator_get_voltage(opp_table->regulators[0]);
+
+	return uV && cur >= (int)uV;
+}
+
+/*
+ * Move @clk to the highest fixed source at or below its current rate, so a
+ * cluster never runs faster on the voltage it has. -ERANGE when there is
+ * none (a cluster left below 491.52 MHz on a PLL divider).
+ */
+static int spacemit_park(struct clk *clk)
+{
+	unsigned long cur = clk_get_rate(clk);
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(spacemit_park_rates); i++) {
+		if (spacemit_park_rates[i] > cur)
+			continue;
+		if (clk_round_rate(clk, spacemit_park_rates[i]) != (long)spacemit_park_rates[i])
+			continue;
+		return clk_set_rate(clk, spacemit_park_rates[i]);
+	}
+
+	return -ERANGE;
+}
+
+static bool spacemit_is_parked(struct clk *clk)
+{
+	unsigned long cur = clk_get_rate(clk);
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(spacemit_park_rates); i++)
+		if (cur == spacemit_park_rates[i])
+			return true;
+
+	return false;
+}
+
+/*
+ * True when the OPP core's current OPP runs cls0 at @rate. The OPP core
+ * writes current_opp from dev_pm_opp_set_rate() without any lock of its
+ * own: this relies on cpufreq serializing the transitions of a policy,
+ * and this notifier runs inside one.
+ */
+static bool spacemit_opp_is_current(struct opp_table *opp_table,
+				    unsigned long rate)
+{
+	struct dev_pm_opp *opp = opp_table->current_opp;
+
+	return opp && dev_pm_opp_get_freq_indexed(opp, 0) == rate;
+}
+
+static int spacemit_processor_notifier(struct notifier_block *nb,
+                                  unsigned long event, void *data)
+{
+	int cpu;
+	struct device *cpu_dev;
+	struct cpufreq_freqs *freqs = (struct cpufreq_freqs *)data;
+	struct cpufreq_policy *policy = freqs->policy;
+	struct opp_table *opp_table;
+	struct clk *pll_clst0, *pll_clst1;
+	unsigned long new_rate = (unsigned long)freqs->new * 1000;
+	unsigned long old_rate;
+	int i, ret;
+
+	cpu = cpumask_first(policy->related_cpus);
+	cpu_dev = get_cpu_device(cpu);
+	opp_table = _find_opp_table(cpu_dev);
+	if (IS_ERR_OR_NULL(opp_table))
+		return NOTIFY_DONE;
+
+	/* Only the K3 cluster tables (cls0 + cls1) are ours */
+	if (opp_table->clk_count < 2 || !opp_table->clks) {
+		dev_pm_opp_put_opp_table(opp_table);
+		return NOTIFY_DONE;
+	}
+
+	if (event == CPUFREQ_POSTCHANGE) {
+		mutex_lock(&spacemit_pll_lock);
+		/*
+		 * A failed transition is rolled back by the core as PRECHANGE +
+		 * POSTCHANGE with old/new swapped, without target_index(): the
+		 * PRECHANGE below then parks the clusters and retunes the PLLs
+		 * for the old rate, and nobody would switch them back. Put the
+		 * clocks this driver parked back here, once cpufreq and the OPP
+		 * core agree on the rate and the rail reads back high enough
+		 * for it; the direction of old/new says nothing, the OPP layer
+		 * may have applied another OPP (and voltage) altogether. A
+		 * cluster stays parked, and remembered as such, rather than run
+		 * above its voltage. After a successful transition nothing is
+		 * left parked.
+		 */
+		if (cpumask_test_cpu(cpu, &spacemit_parked)) {
+			bool parked = false, checked = false, covered = false;
+
+			for (i = 0; i < opp_table->clk_count; ++i) {
+				if (!spacemit_is_parked(opp_table->clks[i]))
+					continue;
+				if (!checked) {
+					/*
+					 * Only follow a rate the OPP core agrees
+					 * on: after a failed transition its
+					 * current_opp is still the old one, while
+					 * this first POSTCHANGE carries the target
+					 * that failed; the rollback POSTCHANGE
+					 * that follows carries the old rate again.
+					 */
+					covered = spacemit_opp_is_current(opp_table, new_rate) &&
+						  spacemit_rail_covers(opp_table, cpu_dev, new_rate);
+					checked = true;
+				}
+				if (!covered) {
+					dev_warn_ratelimited(cpu_dev,
+						"cluster clock %d left parked at %lu kHz (%u kHz asked)\n",
+						i, clk_get_rate(opp_table->clks[i]) / 1000, freqs->new);
+					parked = true;
+					continue;
+				}
+				/*
+				 * The mux rounds to the nearest source, which
+				 * may be above the rate the rail was checked
+				 * for (a PLL left at a higher rate): then stay
+				 * parked.
+				 */
+				if (clk_round_rate(opp_table->clks[i], new_rate) > (long)new_rate)
+					ret = -ERANGE;
+				else
+					ret = clk_set_rate(opp_table->clks[i], new_rate);
+				if (ret) {
+					dev_warn_ratelimited(cpu_dev,
+						"cluster clock %d left parked at %lu kHz (%d)\n",
+						i, clk_get_rate(opp_table->clks[i]) / 1000, ret);
+					parked = true;
+				}
+			}
+			if (!parked)
+				cpumask_clear_cpu(cpu, &spacemit_parked);
+		}
+		/* The clusters hold their own references now */
+		if (spacemit_plls_cached)
+			spacemit_pll_release(cpu);
+		/* Let the idle harts go back to WFI */
+		spacemit_idle_guard_end(policy);
+		mutex_unlock(&spacemit_pll_lock);
+		dev_pm_opp_put_opp_table(opp_table);
+		return NOTIFY_OK;
+	}
+
+	mutex_lock(&spacemit_pll_lock);
+
+	/* PRECHANGE: no hart may sit in WFI until POSTCHANGE */
+	spacemit_idle_guard_begin(policy);
+
+	/*
+	 * Get the pll clk handles once and cache them: this notifier runs
+	 * on every frequency transition, per-call of_clk_get_by_name()
+	 * would leak a reference each time. Only cache a complete set, so
+	 * a transient lookup failure is retried on the next transition.
+	 */
+	if (!spacemit_plls_cached) {
+		spacemit_pll_clst0 = of_clk_get_by_name(opp_table->np, "pll_clst0");
+		spacemit_pll_clst1 = of_clk_get_by_name(opp_table->np, "pll_clst1");
+		spacemit_pll_src = of_clk_get_by_name(opp_table->np, "pll_src");
+		if (!IS_ERR(spacemit_pll_clst0) && !IS_ERR(spacemit_pll_clst1) &&
+		    !IS_ERR(spacemit_pll_src)) {
+			spacemit_plls_cached = true;
+		} else {
+			if (!IS_ERR(spacemit_pll_clst0))
+				clk_put(spacemit_pll_clst0);
+			if (!IS_ERR(spacemit_pll_clst1))
+				clk_put(spacemit_pll_clst1);
+			if (!IS_ERR(spacemit_pll_src))
+				clk_put(spacemit_pll_src);
+			mutex_unlock(&spacemit_pll_lock);
+			dev_pm_opp_put_opp_table(opp_table);
+			return NOTIFY_DONE;
+		}
+	}
+	pll_clst0 = spacemit_pll_clst0;
+	pll_clst1 = spacemit_pll_clst1;
+
+	if (event == CPUFREQ_PRECHANGE) {
+		if (new_rate > TURBO0_FREQUENCY) {
+			/*
+			 * Nothing to retune when both PLLs already run at the
+			 * target rate: the OPP layer just moves the muxes. This
+			 * is also what an out-of-sync notification (no
+			 * target_index() follows) looks like, and parking the
+			 * clusters for it would leave them parked. The PLLs
+			 * are still switched on below: the clusters may be
+			 * coming from a fixed source.
+			 */
+			if (clk_get_rate(pll_clst0) == new_rate &&
+			    clk_get_rate(pll_clst1) == new_rate)
+				goto relock;
+
+			/*
+			 * The turbo PLLs are about to be reprogrammed: park
+			 * every cluster clock still fed by one of them
+			 * (directly or through a divider) on a fixed PLL1
+			 * source first. Look at the clock tree, not
+			 * at freqs->old: firmware may hand over below TURBO0
+			 * while still running from these PLLs. Clocks on a
+			 * fixed source are left alone, so the parked rate
+			 * never exceeds one the current voltage supports.
+			 * Last clock first: cls1 must leave PLL3 before cls0
+			 * does (see K3_C1_SRC7_PLL3).
+			 */
+			for (i = opp_table->clk_count - 1; i >= 0; --i) {
+				if (!spacemit_clk_fed_by(opp_table->clks[i], pll_clst0) &&
+				    !spacemit_clk_fed_by(opp_table->clks[i], pll_clst1))
+					continue;
+				ret = spacemit_park(opp_table->clks[i]);
+				if (ret) {
+					/*
+					 * Never retune a PLL a core still runs
+					 * from: leave both alone, the OPP layer
+					 * then picks what the muxes can offer.
+					 */
+					dev_warn_ratelimited(cpu_dev,
+						"cannot park cluster clock %d (%d), turbo PLLs left untouched\n",
+						i, ret);
+					goto relock;
+				}
+				cpumask_set_cpu(cpu, &spacemit_parked);
+			}
+
+			/* Let a PLL that was just switched off really stop */
+			if (cpumask_test_cpu(cpu, &spacemit_parked))
+				usleep_range(PLL_OFF_SETTLE_US, 2 * PLL_OFF_SETTLE_US);
+
+			/*
+			 * A failed retune cannot stop the transition: the OPP
+			 * layer rounds the target on cls0 and applies the OPP
+			 * (and voltage) the muxes can reach. That only holds
+			 * if both PLLs agree, so a PLL that cannot follow puts
+			 * the other one back and both stay where they were.
+			 */
+			old_rate = clk_get_rate(pll_clst0);
+			ret = clk_set_rate(pll_clst0, new_rate);
+			if (ret) {
+				dev_warn_ratelimited(cpu_dev, "pll_clst0 to %u kHz failed (%d), PLLs left untouched\n",
+						     freqs->new, ret);
+				goto relock;
+			}
+			ret = clk_set_rate(pll_clst1, new_rate);
+			if (ret) {
+				dev_warn_ratelimited(cpu_dev, "pll_clst1 to %u kHz failed (%d), pll_clst0 put back\n",
+						     freqs->new, ret);
+				if (clk_set_rate(pll_clst0, old_rate))
+					dev_warn_ratelimited(cpu_dev, "pll_clst0 back to %lu Hz failed\n",
+							     old_rate);
+			}
+
+relock:
+			/*
+			 * Switch both PLLs on now, on every turbo transition,
+			 * and wait for them to settle beyond the lock flag, so
+			 * that the OPP layer finds them running and locked
+			 * when it moves the clusters onto them. PLL3 is held
+			 * through pll_src (its /1 output): when scaling down
+			 * the OPP core moves cls1 first (e.g. 2.4 -> 2.2 GHz
+			 * after the park, or 1.5 GHz on PLL2 -> 1.4 GHz), and
+			 * a cluster 1 fed by PLL3 (K3_C1_SRC7_PLL3) would
+			 * switch to a gated output before cls0 turns it on.
+			 * Also after a failure above: a cluster that was parked
+			 * may have gated its PLL.
+			 */
+			spacemit_pll_hold(cpu, cpu_dev, spacemit_pll_src, 0);
+			spacemit_pll_hold(cpu, cpu_dev, pll_clst1, 1);
+			usleep_range(PLL_LOCK_SETTLE_US, 2 * PLL_LOCK_SETTLE_US);
+		}
+	}
+
+	mutex_unlock(&spacemit_pll_lock);
+	dev_pm_opp_put_opp_table(opp_table);
+
+	return NOTIFY_OK;
+}
+static struct notifier_block spacemit_processor_notifier_block = {
+	.notifier_call = spacemit_processor_notifier,
+};
+
+static int spacemit_init_cpufreq_table(struct device *dev,
+				       struct cpufreq_frequency_table **table)
+{
+	struct cpufreq_frequency_table *freq_table;
+	struct dev_pm_opp *opp;
+	unsigned long freq;
+	int i, count;
+
+	count = dev_pm_opp_get_opp_count(dev);
+	if (count <= 0)
+		return count ? count : -ENOENT;
+
+	freq_table = kcalloc(count + 1, sizeof(*freq_table), GFP_KERNEL);
+	if (!freq_table)
+		return -ENOMEM;
+
+	for (i = 0, freq = 0; i < count; i++, freq++) {
+		opp = dev_pm_opp_find_freq_ceil_indexed(dev, &freq, 0);
+		if (IS_ERR(opp)) {
+			kfree(freq_table);
+			return PTR_ERR(opp);
+		}
+		freq_table[i].driver_data = i;
+		freq_table[i].frequency = freq / 1000;
+		dev_pm_opp_put(opp);
+	}
+
+	freq_table[i].driver_data = i;
+	freq_table[i].frequency = CPUFREQ_TABLE_END;
+
+	*table = freq_table;
+	return 0;
+}
+
+/*
+ * The OPP core judges the current OPP, and so the scale-up/scale-down
+ * order of voltage and clocks, on cls0 alone. Should firmware hand over
+ * with the two clusters at different rates, both are brought down to a
+ * rate no higher than the slower one (the 819.2 MHz source when that is
+ * below it): that never needs more voltage than the rail already provides,
+ * and the first transition brings both to the same OPP.
+ */
+static void spacemit_align_clusters(struct device *cpu_dev)
+{
+	struct clk *clks[2];
+	unsigned long rate[2], target;
+	long rounded;
+	int i;
+
+	clks[0] = clk_get(cpu_dev, "cls0");
+	if (IS_ERR(clks[0]))
+		return;
+	clks[1] = clk_get(cpu_dev, "cls1");
+	if (IS_ERR(clks[1])) {
+		clk_put(clks[0]);
+		return;
+	}
+
+	rate[0] = clk_get_rate(clks[0]);
+	rate[1] = clk_get_rate(clks[1]);
+	if (rate[0] == rate[1])
+		goto put;
+
+	target = min(rate[0], rate[1]);
+	if (target >= STABLE_FREQUENCY)
+		target = STABLE_FREQUENCY;
+	dev_info(cpu_dev, "clusters boot at %lu and %lu MHz, both brought to %lu MHz\n",
+		 rate[0] / 1000000, rate[1] / 1000000, target / 1000000);
+
+	if (idle_guard)
+		spacemit_harts_awake();
+	/* cls1 first, see K3_C1_SRC7_PLL3 */
+	for (i = 1; i >= 0; i--) {
+		if (rate[i] == target)
+			continue;
+		rounded = clk_round_rate(clks[i], target);
+		if (rounded < 0 || rounded > (long)target ||
+		    clk_set_rate(clks[i], target))
+			dev_warn(cpu_dev, "cannot bring cls%d down to %lu MHz\n",
+				 i, target / 1000000);
+	}
+	if (idle_guard)
+		spacemit_harts_release();
+
+put:
+	clk_put(clks[1]);
+	clk_put(clks[0]);
+}
+
+/*
+ * Say which PLL feeds cluster 1 (see K3_C1_SRC7_PLL3). Informative only:
+ * the transition code is safe either way. The CPU clocks come from the
+ * APMU syscon, whose regmap the clock driver already registered.
+ */
+static void spacemit_report_c1_source(struct device *cpu_dev)
+{
+	struct of_phandle_args args;
+	struct regmap *apmu;
+	u32 val;
+
+	if (of_parse_phandle_with_args(cpu_dev->of_node, "clocks",
+				       "#clock-cells", 1, &args))
+		return;
+	apmu = device_node_to_regmap(args.np);
+	of_node_put(args.np);
+	if (IS_ERR(apmu) || regmap_read(apmu, APMU_CPU_C1_CLK_CTRL, &val))
+		return;
+
+	dev_info(cpu_dev, "cluster 1 turbo source: %s\n",
+		 (val & K3_C1_SRC7_PLL3) ? "PLL3, shared with cluster 0 (firmware)" : "PLL4");
+}
+
+/*
+ * No cluster regulator: never run above the frequency firmware handed over,
+ * its voltage is all we will ever have. Disable every OPP above the lower
+ * of the two cluster rates. Fails closed: if the boot rate cannot be
+ * established, or lies below the lowest OPP (cpufreq would raise the
+ * clusters to it at init), the CPUs are better left without cpufreq at all.
+ */
+static int spacemit_cap_opps_at_boot_rate(struct device *cpu_dev)
+{
+	static const char * const names[] = { "cls0", "cls1" };
+	struct dev_pm_opp *opp;
+	unsigned long boot_rate = ULONG_MAX, rate, freq;
+	struct clk *clk;
+	int i, disabled = 0;
+
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		clk = clk_get(cpu_dev, names[i]);
+		if (IS_ERR(clk))
+			return PTR_ERR(clk);
+		rate = clk_get_rate(clk);
+		clk_put(clk);
+		if (!rate)
+			return -EINVAL;
+		boot_rate = min(boot_rate, rate);
+	}
+
+	freq = 0;
+	opp = dev_pm_opp_find_freq_ceil_indexed(cpu_dev, &freq, 0);
+	if (IS_ERR(opp))
+		return PTR_ERR(opp);
+	dev_pm_opp_put(opp);
+	if (boot_rate < freq) {
+		dev_err(cpu_dev, "no clst-supply and firmware boot rate %lu MHz below the lowest OPP\n",
+			boot_rate / 1000000);
+		return -ENODEV;
+	}
+
+	freq = boot_rate + 1;
+	while (!IS_ERR(opp = dev_pm_opp_find_freq_ceil_indexed(cpu_dev, &freq, 0))) {
+		dev_pm_opp_put(opp);
+		if (!dev_pm_opp_disable(cpu_dev, freq))
+			disabled++;
+		freq++;
+	}
+
+	if (disabled)
+		dev_info(cpu_dev, "no clst-supply: capped at firmware boot rate %lu MHz, %d OPPs disabled\n",
+			 boot_rate / 1000000, disabled);
+
+	return 0;
+}
+
+int spacemit_k3_cpufreq_early_init(struct device *dev, int cpu)
+{
+	struct private_data *priv;
+	struct device *cpu_dev;
+	struct opp_table *opp_table;
+	const char *reg_name[] = { "clst", NULL };
+	const char *clk_name[] = { "cls0", "cls1", NULL };
+	struct dev_pm_opp_config config = {
+		.regulator_names = reg_name,
+		.clk_names = clk_name,
+		.config_clks = dev_pm_opp_config_clks_simple,
+	};
+	bool have_supply;
+	int ret;
+
+	/* dt_cpufreq_early_init() already skipped CPUs covered by a policy */
+	cpu_dev = get_cpu_device(cpu);
+	if (!cpu_dev)
+		return -EPROBE_DEFER;
+
+	/*
+	 * Not a K3, or not a K3 cluster CPU (no cls0/cls1 clocks): generic
+	 * cpufreq-dt path. The machine check matches the notifier's, so a
+	 * two-clock table is never handed to cpufreq-dt without it.
+	 */
+	if (!of_machine_is_compatible("spacemit,k3") ||
+	    of_property_match_string(cpu_dev->of_node, "clock-names", "cls0") < 0)
+		return 0;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	if (!zalloc_cpumask_var(&priv->cpus, GFP_KERNEL))
+		return -ENOMEM;
+
+	cpumask_set_cpu(cpu, priv->cpus);
+	priv->cpu_dev = cpu_dev;
+
+	/*
+	 * The cluster rail is a PMBus VR that firmware programs before
+	 * handoff. When the board DT wires it (clst-supply), let the OPP
+	 * layer raise the voltage before the frequency. Without it the
+	 * voltage cannot be changed from Linux, so the OPPs above the
+	 * firmware boot frequency are disabled below: firmware may hand
+	 * over at a low OPP and its voltage, and running faster on it
+	 * hangs the cluster.
+	 */
+	have_supply = of_property_present(cpu_dev->of_node, "clst-supply");
+	if (!have_supply)
+		config.regulator_names = NULL;
+	/*
+	 * OPP layer will be taking care of regulators now, but it needs to know
+	 * the name of the regulator first.
+	 */
+	priv->opp_token = dev_pm_opp_set_config(cpu_dev, &config);
+	if (priv->opp_token < 0) {
+		ret = priv->opp_token;
+		goto free_cpumask;
+	}
+
+	/*
+	 * The OPP core leaves opp_table->clk unset (ERR_PTR) for a two-clock
+	 * table, but dev_pm_opp_set_rate() rounds the target on it and
+	 * _find_current_opp() reads the boot rate from it. Point it at cls0,
+	 * the OPP core keeps its own clks[] references. policy->clk is
+	 * cpufreq-dt's own handle and is left alone.
+	 */
+	opp_table = _find_opp_table(cpu_dev);
+	if (IS_ERR(opp_table)) {
+		ret = PTR_ERR(opp_table);
+		goto out;
+	}
+	mutex_lock(&opp_table->lock);
+	if (opp_table->clk_count >= 2 && opp_table->clks)
+		opp_table->clk = opp_table->clks[0];
+	mutex_unlock(&opp_table->lock);
+	dev_pm_opp_put_opp_table(opp_table);
+
+	spacemit_report_c1_source(cpu_dev);
+
+	/* Get OPP-sharing information from "operating-points-v2" bindings */
+	ret = dev_pm_opp_of_get_sharing_cpus(cpu_dev, priv->cpus);
+	if (ret)
+		goto out;
+
+	/*
+	 * Initialize OPP tables for all priv->cpus. They will be shared by
+	 * all CPUs which have marked their CPUs shared with OPP bindings.
+	 *
+	 * For platforms not using operating-points-v2 bindings, we do this
+	 * before updating priv->cpus. Otherwise, we will end up creating
+	 * duplicate OPPs for the CPUs.
+	 *
+	 * OPPs might be populated at runtime, don't fail for error here unless
+	 * it is -EPROBE_DEFER.
+	 */
+	ret = dev_pm_opp_of_cpumask_add_table(priv->cpus);
+	if (!ret) {
+		priv->have_static_opps = true;
+	} else if (ret == -EPROBE_DEFER) {
+		goto out;
+	}
+
+	/*
+	 * The OPP table must be initialized, statically or dynamically, by this
+	 * point.
+	 */
+	ret = dev_pm_opp_get_opp_count(cpu_dev);
+	if (ret <= 0) {
+		dev_err(cpu_dev, "OPP table can't be empty\n");
+		ret = -ENODEV;
+		goto out;
+	}
+
+	/* The cap looks at the boot rates, so it comes before the alignment */
+	if (!have_supply) {
+		ret = spacemit_cap_opps_at_boot_rate(cpu_dev);
+		if (ret) {
+			dev_err(cpu_dev, "cannot establish the firmware boot rate (%d), no cpufreq\n", ret);
+			goto out;
+		}
+	}
+	spacemit_align_clusters(cpu_dev);
+
+	/*
+	 * dev_pm_opp_init_cpufreq_table() asserts a single clock per OPP
+	 * table; build the table manually using the indexed helpers which
+	 * support multi-clock OPP entries (cls0 + cls1).
+	 */
+	ret = spacemit_init_cpufreq_table(cpu_dev, &priv->freq_table);
+	if (ret) {
+		dev_err(cpu_dev, "failed to init cpufreq table: %d\n", ret);
+		goto out;
+	}
+
+	cpufreq_dt_add_data(priv);
+
+	return 1;
+
+out:
+	if (priv->have_static_opps)
+		dev_pm_opp_of_cpumask_remove_table(priv->cpus);
+	dev_pm_opp_put_regulators(priv->opp_token);
+free_cpumask:
+	free_cpumask_var(priv->cpus);
+	return ret;
+}
+
+static int __init spacemit_processor_driver_init(void)
+{
+	int ret;
+
+	if (!of_machine_is_compatible("spacemit,k3"))
+		return 0;
+
+	ret = cpufreq_register_notifier(&spacemit_processor_notifier_block,
+					CPUFREQ_TRANSITION_NOTIFIER);
+	if (ret)
+		pr_err("register cpufreq transition notifier failed (%d)\n", ret);
+
+	return ret;
+}
+arch_initcall(spacemit_processor_driver_init);
diff --git a/drivers/opp/core.c b/drivers/opp/core.c
