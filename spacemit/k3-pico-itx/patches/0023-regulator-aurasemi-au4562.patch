new file mode 100644
index 000000000..47d0d8dee
--- /dev/null
+++ b/drivers/regulator/au4562-regulator.c
@@ -0,0 +1,272 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Aura Semiconductor AU4562 dual-output multiphase VR controller
+ *
+ * The controller speaks PMBus. Only what the SpacemiT K3 firmware uses is
+ * implemented here: PAGE selects the output, VOUT_COMMAND holds the target
+ * voltage as a 12-bit value in 5 mV steps. Both outputs are enabled by
+ * hardware (EN pins) and stay on, so only the voltage is controlled.
+ *
+ * PAGE is a shared selector, so a PAGE write and the VOUT_COMMAND access
+ * that follows it are done with the bus segment locked: nothing else on the
+ * bus (another driver, i2c-dev) can slip in and redirect the access to the
+ * other output. Each command is still a complete, STOP-terminated SMBus
+ * transaction, exactly the sequence the firmware itself uses.
+ */
+
+#include <linux/bits.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/driver.h>
+#include <linux/regulator/of_regulator.h>
+
+#define AU4562_PAGE		0x00	/* PMBus PAGE */
+#define AU4562_VOUT_MODE	0x20	/* PMBus VOUT_MODE, logged only */
+#define AU4562_VOUT_COMMAND	0x21	/* PMBus VOUT_COMMAND, 16-bit */
+#define AU4562_VOUT_MASK	GENMASK(11, 0)
+
+#define AU4562_MIN_UV		540000
+#define AU4562_STEP_UV		5000
+#define AU4562_MIN_SEL		0x6c	/* 540 mV */
+#define AU4562_MAX_SEL		0xdc	/* 1100 mV */
+#define AU4562_NUM_OUTPUTS	2
+
+/* Conservative slew rate used when the DT gives no regulator-ramp-delay */
+#define AU4562_RAMP_DELAY_UV_PER_US	2500
+
+struct au4562 {
+	struct i2c_client *client;
+};
+
+static int au4562_smbus(struct i2c_client *client, char read_write, u8 command,
+			int protocol, union i2c_smbus_data *data)
+{
+	return __i2c_smbus_xfer(client->adapter, client->addr, client->flags,
+				read_write, command, protocol, data);
+}
+
+/*
+ * Select @page and read VOUT_COMMAND into *val. When @write is set, the
+ * 12-bit selector @sel then replaces the low bits and the word is written
+ * back, bits 15:12 kept as the firmware does. The whole sequence runs with
+ * the bus segment locked; every command is a complete SMBus transaction.
+ */
+static int au4562_vout_access(struct au4562 *au, unsigned int page,
+			      bool write, unsigned int sel, u16 *val)
+{
+	struct i2c_client *client = au->client;
+	struct i2c_adapter *adap = client->adapter;
+	union i2c_smbus_data data;
+	int ret;
+
+	i2c_lock_bus(adap, I2C_LOCK_SEGMENT);
+
+	data.byte = page;
+	ret = au4562_smbus(client, I2C_SMBUS_WRITE, AU4562_PAGE,
+			   I2C_SMBUS_BYTE_DATA, &data);
+	if (ret)
+		goto unlock;
+
+	ret = au4562_smbus(client, I2C_SMBUS_READ, AU4562_VOUT_COMMAND,
+			   I2C_SMBUS_WORD_DATA, &data);
+	if (ret)
+		goto unlock;
+	*val = data.word;
+
+	if (write) {
+		data.word = (*val & ~AU4562_VOUT_MASK) | sel;
+		ret = au4562_smbus(client, I2C_SMBUS_WRITE, AU4562_VOUT_COMMAND,
+				   I2C_SMBUS_WORD_DATA, &data);
+	}
+
+unlock:
+	i2c_unlock_bus(adap, I2C_LOCK_SEGMENT);
+
+	return ret;
+}
+
+/*
+ * VOUT_MODE is logged for reference only: the 5 mV/LSB scale used here is
+ * what the K3 firmware programs the part with, and no datasheet documents
+ * how the AU4562 reports it, so the value does not gate the probe.
+ */
+static void au4562_log_vout_mode(struct au4562 *au, unsigned int page,
+				 const char *name)
+{
+	struct i2c_client *client = au->client;
+	union i2c_smbus_data data;
+	int ret;
+
+	i2c_lock_bus(client->adapter, I2C_LOCK_SEGMENT);
+	data.byte = page;
+	ret = au4562_smbus(client, I2C_SMBUS_WRITE, AU4562_PAGE,
+			   I2C_SMBUS_BYTE_DATA, &data);
+	if (!ret)
+		ret = au4562_smbus(client, I2C_SMBUS_READ, AU4562_VOUT_MODE,
+				   I2C_SMBUS_BYTE_DATA, &data);
+	i2c_unlock_bus(client->adapter, I2C_LOCK_SEGMENT);
+
+	if (!ret)
+		dev_info(&client->dev, "%s: VOUT_MODE 0x%02x\n", name, data.byte);
+}
+
+static int au4562_read_sel(struct au4562 *au, unsigned int page,
+			   unsigned int *sel)
+{
+	u16 val = 0;
+	int ret;
+
+	ret = au4562_vout_access(au, page, false, 0, &val);
+	if (ret)
+		return ret;
+
+	*sel = val & AU4562_VOUT_MASK;
+
+	/*
+	 * The encoding is only known for the window the firmware programs.
+	 * Anything else means a different VOUT_MODE or a part we do not
+	 * understand: refuse rather than guess a voltage.
+	 */
+	if (*sel < AU4562_MIN_SEL || *sel > AU4562_MAX_SEL)
+		return -ERANGE;
+
+	return 0;
+}
+
+static int au4562_get_voltage_sel(struct regulator_dev *rdev)
+{
+	struct au4562 *au = rdev_get_drvdata(rdev);
+	unsigned int sel;
+	int ret;
+
+	ret = au4562_read_sel(au, rdev_get_id(rdev), &sel);
+	if (ret)
+		return ret;
+
+	return sel;
+}
+
+static int au4562_set_voltage_sel(struct regulator_dev *rdev, unsigned int sel)
+{
+	struct au4562 *au = rdev_get_drvdata(rdev);
+	u16 val;
+
+	return au4562_vout_access(au, rdev_get_id(rdev), true, sel, &val);
+}
+
+static const struct regulator_ops au4562_ops = {
+	.list_voltage		= regulator_list_voltage_linear,
+	.map_voltage		= regulator_map_voltage_linear,
+	.get_voltage_sel	= au4562_get_voltage_sel,
+	.set_voltage_sel	= au4562_set_voltage_sel,
+};
+
+#define AU4562_DESC(_name, _page)					\
+	{								\
+		.name		= _name,				\
+		.of_match	= of_match_ptr(_name),			\
+		.regulators_node = of_match_ptr("regulators"),		\
+		.id		= _page,				\
+		.ops		= &au4562_ops,				\
+		.type		= REGULATOR_VOLTAGE,			\
+		.owner		= THIS_MODULE,				\
+		.min_uV		= AU4562_MIN_UV,			\
+		.uV_step	= AU4562_STEP_UV,			\
+		.linear_min_sel	= AU4562_MIN_SEL,			\
+		.n_voltages	= AU4562_MAX_SEL + 1,			\
+		.ramp_delay	= AU4562_RAMP_DELAY_UV_PER_US,		\
+	}
+
+/* The desc id is the PMBus page: 0 = loop B, 1 = loop A (K3: 1 = X100) */
+static const struct regulator_desc au4562_descs[AU4562_NUM_OUTPUTS] = {
+	AU4562_DESC("vout0", 0),
+	AU4562_DESC("vout1", 1),
+};
+
+static int au4562_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct regulator_config config = { .dev = dev };
+	struct device_node *regulators, *np;
+	struct regulator_dev *rdev;
+	struct au4562 *au;
+	unsigned int sel;
+	int i, ret;
+
+	if (!i2c_check_functionality(client->adapter, I2C_FUNC_SMBUS_BYTE_DATA |
+				     I2C_FUNC_SMBUS_WORD_DATA))
+		return -EOPNOTSUPP;
+
+	au = devm_kzalloc(dev, sizeof(*au), GFP_KERNEL);
+	if (!au)
+		return -ENOMEM;
+
+	au->client = client;
+	config.driver_data = au;
+
+	regulators = of_get_child_by_name(dev->of_node, "regulators");
+	if (!regulators)
+		return dev_err_probe(dev, -ENODEV, "no regulators node\n");
+
+
+	/*
+	 * Only the outputs described in the DT are registered. Before
+	 * touching one, make sure what the firmware left in VOUT_COMMAND
+	 * decodes with the encoding used here.
+	 */
+	for (i = 0; i < AU4562_NUM_OUTPUTS; i++) {
+		np = of_get_child_by_name(regulators, au4562_descs[i].name);
+		if (!np)
+			continue;
+		of_node_put(np);
+
+		ret = au4562_read_sel(au, au4562_descs[i].id, &sel);
+		if (ret) {
+			of_node_put(regulators);
+			return dev_err_probe(dev, ret, ret == -ERANGE ?
+					     "%s: VOUT_COMMAND outside the known window, not driving it\n" :
+					     "%s: cannot read VOUT_COMMAND\n",
+					     au4562_descs[i].name);
+		}
+		dev_dbg(dev, "%s: boot VOUT_COMMAND selector 0x%x\n",
+			au4562_descs[i].name, sel);
+		au4562_log_vout_mode(au, au4562_descs[i].id, au4562_descs[i].name);
+
+		rdev = devm_regulator_register(dev, &au4562_descs[i], &config);
+		if (IS_ERR(rdev)) {
+			of_node_put(regulators);
+			return dev_err_probe(dev, PTR_ERR(rdev),
+					     "failed to register %s\n",
+					     au4562_descs[i].name);
+		}
+	}
+	of_node_put(regulators);
+
+	return 0;
+}
+
+static const struct of_device_id au4562_of_match[] = {
+	{ .compatible = "aurasemi,au4562" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, au4562_of_match);
+
+static const struct i2c_device_id au4562_id[] = {
+	{ .name = "au4562" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, au4562_id);
+
+static struct i2c_driver au4562_driver = {
+	.driver = {
+		.name = "au4562-regulator",
+		.of_match_table = au4562_of_match,
+	},
+	.probe = au4562_probe,
+	.id_table = au4562_id,
+};
+module_i2c_driver(au4562_driver);
+
+MODULE_DESCRIPTION("Aura Semiconductor AU4562 voltage regulator driver");
+MODULE_LICENSE("GPL");
-- 
