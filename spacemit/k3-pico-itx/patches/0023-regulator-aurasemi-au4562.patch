+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/regulator/aurasemi,au4562.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Aura Semiconductor AU4562 dual-output multiphase VR controller
+
+maintainers:
+  - liberodark <liberodark@gmail.com>
+
+description:
+  The AU4562 is a PMBus controlled dual-output multiphase voltage
+  regulator controller. Each output is selected with the PMBus PAGE
+  command and its target voltage programmed through VOUT_COMMAND in
+  5 mV steps. The outputs are enabled by hardware and always on.
+
+properties:
+  compatible:
+    const: aurasemi,au4562
+
+  reg:
+    maxItems: 1
+
+  regulators:
+    type: object
+    additionalProperties: false
+
+    patternProperties:
+      "^vout[01]$":
+        type: object
+        $ref: regulator.yaml#
+        unevaluatedProperties: false
+        description:
+          vout0 is PMBus page 0, vout1 is PMBus page 1.
+
+required:
+  - compatible
+  - reg
+  - regulators
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        regulator@75 {
+            compatible = "aurasemi,au4562";
+            reg = <0x75>;
+
+            regulators {
+                vdd_cpu: vout1 {
+                    regulator-name = "vdd08_x100";
+                    regulator-min-microvolt = <720000>;
+                    regulator-max-microvolt = <1050000>;
+                    regulator-ramp-delay = <2500>;
+                    regulator-always-on;
+                    regulator-boot-on;
+                };
+            };
+        };
+    };
